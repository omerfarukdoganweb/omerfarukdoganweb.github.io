---
import type { SocialPost } from '../types/social';

// Build-time safety: json dosyası yoksa veya API'lerden veri gelmemişse patlamaması için fallback
let posts: SocialPost[] = [];
try {
  // Astro dynamic import ile dosya varlığını kontrol etme
  const module = await import('../data/social.json');
  posts = module.default as SocialPost[];
} catch (e) {
  console.warn("src/data/social.json not found, using fallback empty array.");
  posts = [];
}

function formatDate(dateString: string): string {
  try {
    return new Date(dateString).toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch (e) {
    return dateString;
  }
}
---

<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800 pb-4">
    <div>
      <h2 class="text-lg font-semibold text-neutral-900 dark:text-white">Social Feed</h2>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-0.5">Automated updates from X and LinkedIn</p>
    </div>
  </div>

  {posts.length === 0 ? (
    <div class="p-8 border border-dashed border-neutral-200 dark:border-neutral-800 rounded-xl text-center">
      <p class="text-sm text-neutral-400 dark:text-neutral-500">
        No updates compiled at the moment. Run the fetch script to populate the feed.
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {posts.map((post) => (
        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col justify-between p-5 border border-neutral-200 dark:border-neutral-800 rounded-xl bg-white dark:bg-neutral-900/50 hover:border-neutral-400 dark:hover:border-neutral-600 hover:-translate-y-1 hover:shadow-md transition-all duration-300"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">
                {formatDate(post.date)}
              </span>
              
              {post.platform === 'X' ? (
                // X (Twitter) Icon & Badge
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium bg-neutral-900 dark:bg-neutral-800 text-white">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
                  </svg>
                  X
                </span>
              ) : (
                // LinkedIn Icon & Badge
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium bg-blue-600 dark:bg-blue-900/40 text-white dark:text-blue-200">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/>
                  </svg>
                  LinkedIn
                </span>
              )}
            </div>
            
            <p class="text-sm text-neutral-600 dark:text-neutral-300 line-clamp-4 leading-relaxed whitespace-pre-wrap">
              {post.content}
            </p>
          </div>
          
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500 font-medium">
            <span>Read on platform</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  )}
</div>
