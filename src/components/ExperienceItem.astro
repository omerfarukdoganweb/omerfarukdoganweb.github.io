---
interface Props {
  title: string;
  company: string;
  period: string;
  location?: string;
  type?: string;
  description?: string[];
  isLast?: boolean;
}

const {
  title,
  company,
  period,
  location,
  type,
  description = [],
  isLast = false,
} = Astro.props;
---

<div class="relative pl-8 group">
  <!-- Timeline line -->
  {!isLast && (
    <div class="absolute left-[7px] top-5 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800 transition-colors" />
  )}
  <!-- Timeline dot -->
  <div class="absolute left-0 top-[6px] w-[15px] h-[15px] rounded-full border-2 border-neutral-900 dark:border-white bg-white dark:bg-neutral-950 z-10 transition-colors" />

  <div class="pb-10">
    <!-- Card container with micro-interactions -->
    <div class="p-5 border border-neutral-200 dark:border-neutral-800 rounded-xl bg-white dark:bg-neutral-900/50 hover:border-neutral-400 dark:hover:border-neutral-600 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
        <div>
          <h3 class="font-semibold text-neutral-900 dark:text-white text-base leading-tight">{title}</h3>
          <p class="text-neutral-600 dark:text-neutral-450 text-sm font-medium">{company}</p>
        </div>
        <div class="text-right shrink-0">
          <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded">
            {period}
          </span>
          {type && (
            <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">{type}</p>
          )}
        </div>
      </div>
      {location && (
        <p class="text-xs text-neutral-400 dark:text-neutral-500 mb-2">{location}</p>
      )}
      {description.length > 0 && (
        <ul class="mt-2 space-y-1">
          {description.map((item) => (
            <li class="text-sm text-neutral-600 dark:text-neutral-400 flex gap-2">
              <span class="text-neutral-400 dark:text-neutral-600 shrink-0 mt-0.5">—</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</div>
