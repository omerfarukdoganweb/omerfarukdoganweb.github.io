---
interface Props {
  title: string;
  company: string;
  period: string;
  location?: string;
  type?: string;
  description?: string[];
  isLast?: boolean;
}

const {
  title,
  company,
  period,
  location,
  type,
  description = [],
  isLast = false,
} = Astro.props;
---

<div class="relative pl-8">
  <!-- Timeline line -->
  {!isLast && (
    <div class="absolute left-[7px] top-5 bottom-0 w-px bg-neutral-200" />
  )}
  <!-- Timeline dot -->
  <div class="absolute left-0 top-[6px] w-[15px] h-[15px] rounded-full border-2 border-neutral-900 bg-white z-10" />

  <div class="pb-10">
    <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
      <div>
        <h3 class="font-semibold text-neutral-900 text-base leading-tight">{title}</h3>
        <p class="text-neutral-600 text-sm font-medium">{company}</p>
      </div>
      <div class="text-right shrink-0">
        <span class="text-xs font-mono text-neutral-500 bg-neutral-100 px-2 py-1 rounded">
          {period}
        </span>
        {type && (
          <p class="text-xs text-neutral-400 mt-1">{type}</p>
        )}
      </div>
    </div>
    {location && (
      <p class="text-xs text-neutral-400 mb-2">{location}</p>
    )}
    {description.length > 0 && (
      <ul class="mt-2 space-y-1">
        {description.map((item) => (
          <li class="text-sm text-neutral-600 flex gap-2">
            <span class="text-neutral-400 shrink-0 mt-0.5">—</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
