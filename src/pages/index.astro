---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialFeed from '../components/SocialFeed.astro';
---

<BaseLayout title="Home" description="Industrial Engineer & Business Analyst based in Istanbul — Ömer Faruk Doğan">

  <!-- Hero -->
  <section class="py-16 border-b border-neutral-100 dark:border-neutral-800">
    <div class="flex flex-col gap-6 max-w-2xl">
      <!-- Status badge -->
      <div class="inline-flex items-center gap-2 w-fit">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neutral-400 dark:bg-neutral-600 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-neutral-900 dark:bg-white"></span>
        </span>
        <span class="text-xs font-mono text-neutral-500 dark:text-neutral-450">Available for opportunities</span>
      </div>

      <div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white leading-tight">
          Ömer Faruk<br />Doğan
        </h1>
        <p class="mt-3 text-lg text-neutral-500 dark:text-neutral-400 font-medium">
          Industrial Engineer & Business Analyst
        </p>
        <p class="mt-1 text-sm text-neutral-400 dark:text-neutral-500">
          Pendik, İstanbul · omerfarukdoganweb@gmail.com
        </p>
      </div>

      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-base max-w-xl">
        Industrial Engineering professional and active Business Analyst dedicated to bridging the gap
        between complex technical architectures and strategic business objectives. Combining a robust
        IT background with deep expertise in process optimization, I specialize in translating
        cross-functional requirements into scalable digital solutions within Agile/Scrum environments.
      </p>

      <!-- CTA Links -->
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/cv"
          class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-sm font-medium rounded-lg hover:bg-neutral-700 dark:hover:bg-neutral-200 transition-colors"
        >
          View CV
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="mailto:omerfarukdoganweb@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors"
        >
          Get in touch
        </a>
      </div>

      <!-- Social Icons -->
      <div class="flex items-center gap-4 pt-1">
        <a
          href="https://github.com/omerfarukdogan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-450 hover:text-neutral-900 dark:hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/omerfarukdogan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-450 hover:text-neutral-900 dark:hover:text-white transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a
          href="https://x.com/omerfarukdogan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-450 hover:text-neutral-900 dark:hover:text-white transition-colors"
          aria-label="X"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
          </svg>
          X
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Stats / Highlights -->
  <section class="py-12 border-b border-neutral-100 dark:border-neutral-800">
    <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-8">Highlights</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="p-5 border border-neutral-200 dark:border-neutral-800 rounded-xl hover:border-neutral-400 dark:hover:border-neutral-600 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
        <p class="text-2xl font-bold text-neutral-900 dark:text-white">10+</p>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">Years of hands-on experience across software, e-commerce & industrial engineering</p>
      </div>
      <div class="p-5 border border-neutral-200 dark:border-neutral-800 rounded-xl hover:border-neutral-400 dark:hover:border-neutral-600 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
        <p class="text-2xl font-bold text-neutral-900 dark:text-white">TÜBİTAK</p>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">1812 BİGG acceptance for GlicoGo — a data-driven health-tech startup</p>
      </div>
      <div class="p-5 border border-neutral-200 dark:border-neutral-800 rounded-xl hover:border-neutral-400 dark:hover:border-neutral-600 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
        <p class="text-2xl font-bold text-neutral-900 dark:text-white">#1</p>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">T3 Vakfı SİNAPS Girişimcilik Programme — 1st place</p>
      </div>
    </div>
  </section>

  <!-- Skills snapshot -->
  <section class="py-12 border-b border-neutral-100 dark:border-neutral-800">
    <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-8">Core Skills</h2>
    <div class="flex flex-wrap gap-2">
      {[
        'Deep Learning', 'Analytics', 'English', 'TypeScript',
        'React Native', 'Python', 'Sistem Dinamikleri', 'SQL',
        'Agile / Scrum', 'Process Optimization', 'BRD / FRD', 'MRP',
      ].map((skill) => (
        <span class="px-3 py-1.5 text-sm font-medium bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-850 transition-colors">
          {skill}
        </span>
      ))}
    </div>
  </section>

  <!-- Social Feed Section -->
  <section class="py-12 border-b border-neutral-100 dark:border-neutral-800">
    <SocialFeed />
  </section>

  <!-- Recent Certificates -->
  <section class="py-12">
    <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-8">Certificates & Awards</h2>
    <ul class="space-y-3">
      {[
        { label: 'Fundamentals of Digital Marketing', issuer: 'Google' },
        { label: 'Mobile Experience Certification', issuer: 'Google' },
        { label: 'Derin Öğrenmeye Giriş Bootcamp', issuer: 'Akbank' },
        { label: 'Yeşil Gelecek: Enerji Dönüşümü ve Sürdürülebilirlik', issuer: 'Certificate' },
        { label: 'Programming Certificates (SQL, Python, JavaScript, Java)', issuer: 'Various' },
      ].map((cert) => (
        <li class="flex items-start gap-3 text-sm">
          <span class="text-neutral-300 dark:text-neutral-700 mt-0.5">▸</span>
          <span>
            <span class="font-medium text-neutral-800 dark:text-neutral-200">{cert.label}</span>
            <span class="text-neutral-400 dark:text-neutral-500 ml-2">· {cert.issuer}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>
